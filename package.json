{
  "name": "supreme-guide",
  "private": true,
  "version": "1.1.0",
  "description": "SUPREME GUIDE \u2014 Every Journey Is a Game! The global travel quiz game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/offline.mjs",
    "data": "python3 scripts/build_data.py",
    "i18n": "tsx scripts/i18n-extract.ts",
    "i18n:check": "tsx scripts/i18n-extract.ts --check && node scripts/i18n-validate.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "idb": "^8.0.4",
    "maplibre-gl": "^6.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.7.0",
    "airport-data-js": "^4.0.0",
    "all-the-cities": "^3.1.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
